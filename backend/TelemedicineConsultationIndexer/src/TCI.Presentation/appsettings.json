{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "TCI": "Information"
    }
  },
  "Console": {
    "FormatterName": "json",
    "FormatterOptions": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
      "UseUtcTimestamp": true,
      "JsonWriterOptions": {
        "Indented": false
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "TCI.Api",
    "Audience": "TCI.Frontend",
    "ExpirationMinutes": 60
  },
  "RateLimiting": {
    "General": {
      "PermitLimit": 100,
      "WindowInMinutes": 1,
      "SegmentsPerWindow": 4
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowInMinutes": 1,
      "SegmentsPerWindow": 4
    },
    "Upload": {
      "PermitLimit": 5,
      "WindowInMinutes": 10,
      "SegmentsPerWindow": 5
    },
    "Search": {
      "PermitLimit": 30,
      "WindowInMinutes": 1,
      "SegmentsPerWindow": 4
    }
  },
  "FileStorage": {
    "RootPath": "../../../../storage/consultations"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ProcessingQueueName": "consultation.processing",
    "ClientProvidedName": "tci-api-publisher"
  }
}
